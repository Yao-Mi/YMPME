execute_process(COMMAND "${PROGRAM}" stderr RESULT_VARIABLE result ERROR_VARIABLE err)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Normal error logging terminated process: ${result}")
endif()
if(EXPECT_STDERR)
    if(NOT err MATCHES "PME ERROR.*Invalid argument.*stderr-probe.*test_modes.c:[0-9]+ main" OR err MATCHES "MUTED|FILTERED")
        message(FATAL_ERROR "Incorrect default stderr output: ${err}")
    endif()
elseif(NOT "${err}" STREQUAL "")
    message(FATAL_ERROR "Unexpected output with stderr disabled: ${err}")
endif()
execute_process(COMMAND "${PROGRAM}" assert RESULT_VARIABLE result ERROR_VARIABLE err)
if(EXPECT_ASSERT)
    if("${result}" STREQUAL "0")
        message(FATAL_ERROR "Enabled assertion did not terminate")
    endif()
    if(EXPECT_STDERR AND NOT err MATCHES "Assertion failed.*assert-probe")
        message(FATAL_ERROR "Assertion lacks diagnostic: ${err}")
    endif()
elseif(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Disabled assertion terminated: ${result}")
endif()

execute_process(COMMAND "${PROGRAM}" assert_muted RESULT_VARIABLE result ERROR_VARIABLE err)
if(NOT "${err}" STREQUAL "")
    message(FATAL_ERROR "Muted assertion unexpectedly printed: ${err}")
endif()
if(EXPECT_ASSERT AND "${result}" STREQUAL "0")
    message(FATAL_ERROR "Muting logs incorrectly disabled assertions")
elseif(NOT EXPECT_ASSERT AND NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Disabled muted assertion terminated: ${result}")
endif()
