# Only pure PME libraries are exported. GRE adapters and demo assemblies stay external.
include(CMakePackageConfigHelpers)
set(_ympme_modules ympme rigid joint dynamics query flight
    drive terrain suspension vehicle gear belt pulley rope aircraft pendulum
    surface_atlas skin_contact softbody sensor sensor_geometry
    imu encoder force_sensor laser lidar depth tactile)
set(YMPME_SDK_COMPONENTS "")
set(_ympme_install_targets "")
foreach(_module IN LISTS _ympme_modules)
    if(_module STREQUAL "ympme")
        set(_target ympme)
    else()
        set(_target "ympme_${_module}")
    endif()
    if(TARGET ${_target})
        set_target_properties(${_target} PROPERTIES EXPORT_NAME ${_module})
        list(APPEND _ympme_install_targets ${_target})
        list(APPEND YMPME_SDK_COMPONENTS ${_module})
    endif()
endforeach()
option(YMPME_SDK_UNIFIED "Export all enabled functionality as a single archive" OFF)
if(YMPME_SDK_UNIFIED)
    foreach(_module IN LISTS _ympme_modules)
        if(NOT _module IN_LIST YMPME_SDK_COMPONENTS)
            message(FATAL_ERROR "Unified SDK requires all modules; missing ${_module}")
        endif()
    endforeach()
    set(_unified_sources "")
    set(_unified_definitions PME_SDK_UNIFIED=1)
    foreach(_target IN LISTS _ympme_install_targets)
        get_target_property(_dir ${_target} SOURCE_DIR)
        get_target_property(_sources ${_target} SOURCES)
        foreach(_source IN LISTS _sources)
            get_filename_component(_absolute "${_source}" ABSOLUTE BASE_DIR "${_dir}")
            list(APPEND _unified_sources "${_absolute}")
        endforeach()
        get_target_property(_definitions ${_target} COMPILE_DEFINITIONS)
        if(_definitions)
            list(APPEND _unified_definitions ${_definitions})
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _unified_sources)
    list(REMOVE_DUPLICATES _unified_definitions)
    add_library(ympme_unified STATIC ${_unified_sources})
    set_target_properties(ympme_unified PROPERTIES OUTPUT_NAME ympme EXPORT_NAME ympme
        ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/unified")
    target_include_directories(ympme_unified PUBLIC
        $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/YMPME> $<INSTALL_INTERFACE:include/YMPME>)
    target_compile_definitions(ympme_unified PUBLIC ${_unified_definitions})
    if(NOT MSVC)
        target_link_libraries(ympme_unified PUBLIC m)
        target_compile_options(ympme_unified PRIVATE -Wall -Wextra -Wpedantic -Werror)
    endif()
    set(_ympme_install_targets ympme_unified)
    # The prebuilt unified headers also work for direct cc -I ... libympme.a -lm usage.
    set(_feature_defaults "")
    foreach(_definition IN LISTS _unified_definitions)
        string(REPLACE "=" ";" _pair "${_definition}")
        list(GET _pair 0 _key)
        list(GET _pair 1 _value)
        string(APPEND _feature_defaults
            "#ifndef ${_key}\n#define ${_key} ${_value}\n#elif ${_key} != ${_value}\n#error \"Unified SDK feature configuration mismatch: ${_key}\"\n#endif\n")
    endforeach()
    file(READ "${PROJECT_SOURCE_DIR}/YMPME/CONFIG/YMPME_Features.h" _features)
    string(REPLACE "#define YMPME_FEATURES_H" "#define YMPME_FEATURES_H\n${_feature_defaults}" _features "${_features}")
    file(GENERATE OUTPUT "${PROJECT_BINARY_DIR}/unified-headers/YMPME_Features.h" CONTENT "${_features}")
    file(READ "${PROJECT_SOURCE_DIR}/YMPME/YMPME.h" _umbrella)
    file(GLOB_RECURSE _public_headers RELATIVE "${PROJECT_SOURCE_DIR}/YMPME"
        "${PROJECT_SOURCE_DIR}/YMPME/MODEL/*.h" "${PROJECT_SOURCE_DIR}/YMPME/SENSOR/*.h")
    set(_includes "")
    foreach(_header IN LISTS _public_headers)
        if(NOT _header MATCHES "Internal\\.h$")
            string(APPEND _includes "#include \"${_header}\"\n")
        endif()
    endforeach()
    string(REGEX REPLACE "#endif[\r\n]*$" "${_includes}#endif\n" _umbrella "${_umbrella}")
    file(WRITE "${PROJECT_BINARY_DIR}/unified-headers/YMPME.h" "${_umbrella}")
endif()
install(TARGETS ${_ympme_install_targets} EXPORT YMPMETargets ARCHIVE DESTINATION lib)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/YMPME/" DESTINATION include/YMPME
    FILES_MATCHING PATTERN "*.h" PATTERN "BRIDGE" EXCLUDE)
if(YMPME_SDK_UNIFIED)
    install(FILES "${PROJECT_BINARY_DIR}/unified-headers/YMPME_Features.h" DESTINATION include/YMPME/CONFIG)
    install(FILES "${PROJECT_BINARY_DIR}/unified-headers/YMPME.h" DESTINATION include/YMPME)
endif()
install(EXPORT YMPMETargets NAMESPACE YMPME:: DESTINATION cmake)
configure_package_config_file("${CMAKE_CURRENT_LIST_DIR}/YMPMEConfig.cmake.in"
    "${PROJECT_BINARY_DIR}/YMPMEConfig.cmake" INSTALL_DESTINATION cmake)
write_basic_package_version_file("${PROJECT_BINARY_DIR}/YMPMEConfigVersion.cmake"
    VERSION ${PROJECT_VERSION} COMPATIBILITY SameMinorVersion)
install(FILES "${PROJECT_BINARY_DIR}/YMPMEConfig.cmake"
    "${PROJECT_BINARY_DIR}/YMPMEConfigVersion.cmake" DESTINATION cmake)
if(YMPME_SDK_UNIFIED)
    install(FILES "${PROJECT_SOURCE_DIR}/sdk/README-unified.md" DESTINATION . RENAME README.md)
else()
    install(FILES "${PROJECT_SOURCE_DIR}/sdk/README.md" DESTINATION .)
endif()
install(FILES "${PROJECT_SOURCE_DIR}/sdk/手册.md" DESTINATION .)
install(FILES "${PROJECT_SOURCE_DIR}/API.md" "${PROJECT_SOURCE_DIR}/ARCHITECTURE.md"
    "${PROJECT_SOURCE_DIR}/MESH_COLLISION.md" DESTINATION docs)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/sdk/examples/" DESTINATION examples)
