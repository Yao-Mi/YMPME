@PACKAGE_INIT@
set(YMPME_VERSION "@PROJECT_VERSION@")
if(DEFINED YMPME_INDEX_BITS AND NOT YMPME_INDEX_BITS STREQUAL "@YMPME_INDEX_BITS@")
    message(FATAL_ERROR "This PME variant requires YMPME_INDEX_BITS=@YMPME_INDEX_BITS@")
endif()
set(YMPME_INDEX_BITS @YMPME_INDEX_BITS@)

include("${CMAKE_CURRENT_LIST_DIR}/YMPMETargets.cmake")
set(YMPME_AVAILABLE_COMPONENTS "@YMPME_SDK_COMPONENTS@")
set(YMPME_SDK_UNIFIED @YMPME_SDK_UNIFIED@)
# Preserve old module target names for source compatibility; all resolve to the same archive.
if(YMPME_SDK_UNIFIED)
    foreach(_component IN LISTS YMPME_AVAILABLE_COMPONENTS)
        if(NOT TARGET YMPME::${_component})
            add_library(YMPME::${_component} INTERFACE IMPORTED)
            set_target_properties(YMPME::${_component} PROPERTIES INTERFACE_LINK_LIBRARIES YMPME::ympme)
        endif()
    endforeach()
endif()

foreach(_component IN LISTS YMPME_FIND_COMPONENTS)
    if(_component IN_LIST YMPME_AVAILABLE_COMPONENTS)
        set(YMPME_${_component}_FOUND TRUE)
    else()
        set(YMPME_${_component}_FOUND FALSE)
        set(YMPME_NOT_FOUND_MESSAGE "Component '${_component}' is not in this YMPME build. Available: ${YMPME_AVAILABLE_COMPONENTS}")
    endif()
endforeach()
check_required_components(YMPME)
